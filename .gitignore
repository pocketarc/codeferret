node_modules/
vendor/
.env

# A global gitignore excludes .claude. Un-exclude it so a repository-local lens under
# .claude/skills/ can be committed; the action resolves lens names there as well as in
# its own bundled lenses.
!.claude/
.claude/settings.local.json

# The same global gitignore excludes CLAUDE.md. This one is committed on purpose: it
# carries the rules for working on the fixture branches, which anyone cloning the
# repository needs.
!CLAUDE.md
